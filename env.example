# Environment Variables Example
# Copy env.local.example to .env.local for local development, or
# env.production.example to .env.production for a production build.

# API Configuration
# For local development (direct backend):
NEXT_PUBLIC_API_URL=http://odamak.test/api
INTERNAL_API_URL=http://odamak.test/api

# Production API:
# NEXT_PUBLIC_API_URL=https://odamak.com

# Canonical site and search-console verification
SITE_URL=https://odamak.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional verified Odamak social profiles
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Environment
NODE_ENV=development
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEmG76SwgrNfKpoF
NEXT_PUBLIC_TURNSTILE_MODE=managed

# Shared secret the Laravel API uses to call POST /api/revalidate after prices change
REVALIDATE_SECRET=
