# Production configuration. Copy this file to .env.production before building.
NEXT_PUBLIC_API_URL=https://odamak.com
SITE_URL=https://odamak.com

# Set the production Turnstile site key in the deployment environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEmG76SwgrNfKpoF
NEXT_PUBLIC_TURNSTILE_MODE=managed

# Shared secret the Laravel API uses to call POST /api/revalidate after prices change
REVALIDATE_SECRET=
